PORT=4000
# Comma-separated origins for web + Android webview + localhost dev:
# Example: http://localhost:5173,http://127.0.0.1:5173,https://typingwork24.in,https://www.typingwork24.in,capacitor://localhost,http://localhost
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,https://typingwork24.in,https://www.typingwork24.in,capacitor://localhost,http://localhost

# Use long random secrets in production
ACCESS_TOKEN_SECRET=720fff76cdf57d0295180abb5f74df543c959e86be6c5baee1291132a0a6ee8e
REFRESH_TOKEN_SECRET=dcea31e9ab9e4b25f9f644a4850bc0000d489634f20bb65dafb265bf503fc8d5

# Access token life and refresh token life
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

# PostgreSQL connection from Hostinger VPS
# VPS IP: 72.60.99.29 | Domain: typingwork24.com
# After VPS setup, replace with: postgresql://premium24_user:YOUR_PASSWORD@72.60.99.29:5432/premium24
DATABASE_URL=postgresql://premium24_user:Premium24_DB_2024_Secure!@72.60.99.29:5432/premium24

# Set true if your Postgres endpoint requires SSL
DB_SSL=false

# ============================================
# FIREBASE ADMIN SDK (typingwork24 project)
# ============================================
# OPTION 1: Store key in separate file (RECOMMENDED)
# 1. Download key from: https://console.firebase.google.com/project/typingwork24/settings/serviceaccounts/adminsdk
# 2. Click "Generate New Private Key" 
# 3. Save JSON file as: backend/firebase-key.json
# 4. Uncomment below:
# FIREBASE_KEY_FILE=./firebase-key.json

# OPTION 2: Store directly in .env (not recommended for production)
FIREBASE_PROJECT_ID=typingwork24
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@typingwork24.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...real newlines needed...\n-----END PRIVATE KEY-----\n

# Google OAuth Web client ID (not Android client ID)
GOOGLE_CLIENT_ID=999558251004-og9rn5p3ojthq0a9cgbac9ef20grg3sb.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# Required to run first-time setup endpoint POST /api/setup/init
# Pass this value in header: x-setup-key
SETUP_API_KEY=e47c58e3-d7b0-4e9e-b5c3-1a2f8e4d6c7b

# WatchPay Payment Gateway Configuration
# IMPORTANT: Payment Key is generated after IP binding with WatchPay
# Procedure:
# 1. Get your server IP from your hosting provider (e.g., Hostinger VPS)
# 2. Contact WatchPay business manager with: Merchant ID (100528114) and Server IP
# 3. Wait for WatchPay to bind your IP and generate a Payment Key
# 4. Update WATCHPAY_API_KEY below with the generated key
# 5. Set ENABLE_MOCK_PAYMENTS=false for production

# For local development without a valid Payment Key, enable mock payments:
ENABLE_MOCK_PAYMENTS=true

WATCHPAY_BASE_URL=https://merchant.watchglb.com
WATCHPAY_MERCHANT_ID=100528114
WATCHPAY_CURRENCY=INR
WATCHPAY_API_KEY=CTNB4ATD5XSZMKYFST1ED1HHY9JEUKEP
