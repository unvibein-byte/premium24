PORT=4000
# Comma-separated origins for web + Android webview + localhost dev
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,https://typingwork24.com,https://www.typingwork24.com,capacitor://localhost,http://localhost

# ============================================
# TOKEN SECRETS - Generate secure random values
# On Linux/Mac: openssl rand -base64 32
# ============================================
ACCESS_TOKEN_SECRET=change_me_to_random_32_char_secret_1
REFRESH_TOKEN_SECRET=change_me_to_random_32_char_secret_2

# Access and refresh token expiration
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

# ============================================
# HOSTINGER VPS DATABASE
# ============================================
# PostgreSQL connection to Hostinger VPS (72.60.99.29)
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://premium24_user:CHANGE_TO_YOUR_PASSWORD@72.60.99.29:5432/premium24
DB_SSL=false

# ============================================
# FIREBASE AUTHENTICATION (Optional)
# ============================================
# Leave empty or use "none" to disable Firebase
FIREBASE_PROJECT_ID=none
FIREBASE_CLIENT_EMAIL=none
FIREBASE_PRIVATE_KEY=none

# ============================================
# SETUP API KEY - Required for /api/setup/init endpoint
# ============================================
# Generate: openssl rand -base64 32
SETUP_API_KEY=change_me_to_random_setup_key

# ============================================
# WATCHPAY PAYMENT GATEWAY (for production)
# ============================================
# For local development, keep ENABLE_MOCK_PAYMENTS=true
# For production, contact WatchPay support@watchglb.com with:
#   - Merchant ID: 100528114
#   - VPS IP: 72.60.99.29
# WatchPay will provide WATCHPAY_API_KEY after IP binding

ENABLE_MOCK_PAYMENTS=true
WATCHPAY_BASE_URL=https://merchant.watchglb.com
WATCHPAY_API_KEY=waiting_for_watchpay_connection
