PORT=4000
# Comma-separated origins for web + Android webview + localhost dev:
# Example: http://localhost:5173,http://127.0.0.1:5173,https://typingwork24.com,https://www.typingwork24.com,capacitor://localhost,http://localhost
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,https://typingwork24.com,https://www.typingwork24.com,capacitor://localhost,http://localhost

# Use long random secrets in production
ACCESS_TOKEN_SECRET=replace_with_a_long_random_secret
REFRESH_TOKEN_SECRET=replace_with_a_different_long_random_secret

# Access token life and refresh token life
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

# PostgreSQL connection from Hostinger VPS
# Example: postgresql://username:password@127.0.0.1:5432/premium24
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/premium24

# Set true if your Postgres endpoint requires SSL
DB_SSL=false

# Firebase Admin service account (for verifying Firebase ID tokens)
FIREBASE_PROJECT_ID=replace_with_firebase_project_id
FIREBASE_CLIENT_EMAIL=replace_with_service_account_email
# Keep escaped newlines (\n) when storing in .env
FIREBASE_PRIVATE_KEY=replace_with_service_account_private_key

# Required to run first-time setup endpoint POST /api/setup/init
# Pass this value in header: x-setup-key
SETUP_API_KEY=replace_with_a_long_random_setup_key